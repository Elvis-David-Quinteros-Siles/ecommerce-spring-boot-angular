# ===== Ecommerce - variables de entorno (NO subir a git) =====
COMPOSE_PROJECT_NAME=ecommerce

# Interfaz y puerto donde se publica el frontend (127.0.0.1 = solo esta maquina)
FRONTEND_BIND=0.0.0.0
# Puerto publico del frontend (nginx). La app queda en http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=10020
PUBLIC_URL=http://localhost:10020

# PostgreSQL: contenedor existente "postgres" (fuera del compose)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=cambiar

# MinIO: contenedor "ecommerce-minio" (fuera del compose, ver minio/run-minio.ps1)
MINIO_CONTAINER=ecommerce-minio
MINIO_NETWORK=ecommerce-minio-net
MINIO_CONSOLE_PORT=10021
MINIO_ROOT_USER=ecommerce_minio
MINIO_ROOT_PASSWORD=cambiar_min_8_caracteres
MINIO_BUCKET=ecommerce-images

# PayPal sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Clave de firma de los JWT (minimo 64 caracteres). Generar con: openssl rand -hex 64
JWT_SECRET=cambiar_por_un_valor_aleatorio_de_64_caracteres_o_mas
